# Dev server
API_HOST=127.0.0.1
API_PORT=8787

# Persistence driver: json | mysql
# - json: uses server/market.json
# - mysql: uses MySQL (tables are auto-created on startup)
DB_DRIVER=json

# MySQL connection (used when DB_DRIVER=mysql)
# Tip: this repo includes docker-compose.yml that spins up MySQL with these defaults.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=market
MYSQL_PASSWORD=marketpass
MYSQL_DATABASE=market_simulator

# Auth token signing (keep stable if you want sessions to survive restarts)
AUTH_SECRET=dev-secret
